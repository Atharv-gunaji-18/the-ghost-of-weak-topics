# LLM Backend Configuration
OLLAMA_BASE_URL=http://localhost:11434
# Recommended Gemma 4 models:
# - gemma4:e2b (Lightweight 2B Edge, ideal for laptops)
# - gemma4:e4b (Standard 4B Edge, default balanced)
# - gemma4:12b (Workstation 12B)
# - gemma4:26b (Mixture-of-Experts)
GEMMA_MODEL=gemma4:e2b

# Database Configuration
DB_PATH=ghost_tutor.db

# Request Timeout (seconds)
MODEL_TIMEOUT=60
